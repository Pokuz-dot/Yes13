<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="740"
        x:Class="Avalo.MainWindow"
        Title="Аллюр - Конноспортивный клуб и ипподром"
        Width="1160" Height="740"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <DockPanel>
            <!-- Неизменная верхняя панель с логотипом, переключателем и профилем -->
            <Border x:Name="TopPanel"
                    DockPanel.Dock="Top"
                    IsVisible="False"
                    Background="#FAF6F2"
                    BorderBrush="#D7CCC8"
                    BorderThickness="0,0,0,1.5"
                    Padding="18,10">
                <Grid ColumnDefinitions="*,Auto,*">
                    <!-- Левая зона: логотип и название -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#E65100">
                            <TextBlock Text="А"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="КСК «Аллюр»"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#3E2723" />
                            <TextBlock Text="Конноспортивный клуб"
                                       FontSize="11"
                                       Foreground="#8D6E63" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Центр: переключатель разделов -->
                    <Border Grid.Column="1" Classes="toggle-container" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="BtnClub" Classes="toggle-btn" Content="Клуб Аллюр" />
                            <Button x:Name="BtnHippodrome" Classes="toggle-btn" Content="Ипподром" />
                        </StackPanel>
                    </Border>

                    <!-- Правая зона: профиль пользователя -->
                    <Button x:Name="BtnProfile"
                            Grid.Column="2"
                            Classes="profile-btn"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Профиль пользователя и настройки">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border x:Name="ProfileAvatarBorder"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="#4E342E">
                                <TextBlock x:Name="ProfileInitialsText"
                                           Text="ИА"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="ProfileNameText"
                                           Text="Иванова А.С."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#3E2723" />
                                <TextBlock x:Name="ProfileRoleText"
                                           Text="Администратор манежа"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Незаметная нижняя строка статуса с таймером академического часа (45 мин) -->
            <Border x:Name="BottomStatusBar"
                    DockPanel.Dock="Bottom"
                    IsVisible="False"
                    Background="#E5D9CD"
                    BorderBrush="#D7CCC8"
                    BorderThickness="0,1,0,0"
                    Padding="14,3">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0"
                               Text="КСК и ипподром «Аллюр» • Академический час: 45 мин"
                               FontSize="10.5"
                               Foreground="#8D6E63"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="ShiftTimerBox"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="Смена:"
                                   FontSize="10.5"
                                   Foreground="#8D6E63"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TimerValueText"
                                   Text="45:00"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#6D4C41"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   ToolTip.Tip="Нажмите на время для переключения 45:00 / тест 00:05" />
                        <Button x:Name="BtnTimerToggle"
                                Classes="timer-btn"
                                Content="Старт"
                                ToolTip.Tip="Старт или пауза таймера смены" />
                        <Button x:Name="BtnTimerReset"
                                Classes="timer-btn"
                                Content="Сброс"
                                ToolTip.Tip="Сбросить таймер (45:00)" />
                        <Button x:Name="BtnTimerSound"
                                Classes="timer-btn"
                                Content="Звук"
                                ToolTip.Tip="Проверить звуковой сигнал окончания смены" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основная область страниц -->
            <Grid>
                <ContentControl x:Name="MainContent" />
            </Grid>
        </DockPanel>

        <!-- Всплывающее уведомление (Toast) -->
        <Border x:Name="ToastBanner"
                IsVisible="False"
                Background="#3E2723"
                BorderBrush="#E65100"
                BorderThickness="2"
                CornerRadius="10"
                Padding="16,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,22,34">
            <TextBlock x:Name="ToastMessageText"
                       Text=""
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Border>

        <!-- Слой модального окна -->
        <Border x:Name="ModalOverlay"
                IsVisible="False"
                Background="#7A261612"
                Padding="24">
            <Border Background="White"
                    BorderBrush="#8D6E63"
                    BorderThickness="2"
                    CornerRadius="14"
                    Padding="24"
                    MinWidth="430"
                    MaxWidth="590"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="ModalHost" />
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
